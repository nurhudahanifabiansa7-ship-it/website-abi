<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Making Faaasssttt Food - Layanan Pesan Makanan Kilat Purwokerto</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff1f2',
                            100: '#ffe4e6',
                            500: '#f43f5e',
                            600: '#e11d48',
                            700: '#be123c',
                        },
                        fastYellow: '#FFB800',
                        fastOrange: '#FF5722',
                        purwoDark: '#1E2229'
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
        }

        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .badge-pulse {
            animation: pulse-ring 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }

        @keyframes pulse-ring {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.05); }
        }

        .speed-lines {
            background: repeating-linear-gradient(
                -45deg,
                rgba(255, 255, 255, 0.15),
                rgba(255, 255, 255, 0.15) 10px,
                transparent 10px,
                transparent 20px
            );
        }
    </style>
</head>
<body class="text-slate-800 pb-20 md:pb-6">

    <!-- Top Header Navigation -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 gap-2 md:gap-4">
                
                <!-- Logo & Brand -->
                <div class="flex items-center gap-2 cursor-pointer" onclick="resetFilters()">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-fastOrange to-fastYellow flex items-center justify-center text-white font-extrabold text-xl shadow-md shadow-orange-500/30 transform -rotate-3 hover:rotate-0 transition">
                        <i class="fa-solid fa-bolt-lightning animate-bounce"></i>
                    </div>
                    <div>
                        <span class="text-lg md:text-xl font-black italic tracking-tight bg-gradient-to-r from-fastOrange via-red-600 to-amber-500 bg-clip-text text-transparent">
                            Making Faaasssttt
                        </span>
                        <span class="block -mt-1 text-[10px] font-extrabold uppercase tracking-widest text-slate-500">
                            Food Purwokerto
                        </span>
                    </div>
                </div>

                <!-- Location Picker -->
                <div class="hidden md:flex items-center bg-slate-100 hover:bg-slate-200/80 px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 transition cursor-pointer" onclick="openLocationModal()">
                    <i class="fa-solid fa-location-dot text-fastOrange mr-2 text-sm"></i>
                    <span class="text-slate-500 mr-1">Antar ke:</span>
                    <span id="selected-location-text" class="text-slate-900 font-bold truncate max-w-[150px]">Kampus UNSOED, PWT</span>
                    <i class="fa-solid fa-chevron-down ml-2 text-slate-400 text-[10px]"></i>
                </div>

                <!-- Fast Delivery Badge -->
                <div class="hidden lg:flex items-center bg-amber-50 border border-amber-200 text-amber-800 px-3 py-1.5 rounded-full text-xs font-bold gap-2">
                    <span class="relative flex h-2 w-2">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                    </span>
                    <span>⚡ Kilat Delivery ~15-25 Mins di Purwokerto</span>
                </div>

                <!-- Action Right: Favorites & Cart Floating Mobile Trigger -->
                <div class="flex items-center gap-2">
                    <button onclick="toggleFavoritesView()" class="relative p-2 text-slate-600 hover:text-fastOrange hover:bg-slate-100 rounded-full transition">
                        <i class="fa-solid fa-heart text-lg"></i>
                        <span id="fav-count" class="hidden absolute top-0 right-0 w-4 h-4 bg-red-500 text-white text-[10px] font-bold rounded-full items-center justify-center">0</span>
                    </button>

                    <button onclick="toggleCartDrawer()" class="relative bg-gradient-to-r from-fastOrange to-red-600 hover:from-orange-600 hover:to-red-700 text-white px-4 py-2 rounded-full font-bold text-sm shadow-lg shadow-orange-500/25 flex items-center gap-2 transition active:scale-95">
                        <i class="fa-solid fa-basket-shopping"></i>
                        <span class="hidden sm:inline">Keranjang</span>
                        <span id="cart-badge" class="bg-white text-fastOrange font-black text-xs px-2 py-0.5 rounded-full">0</span>
                    </button>
                </div>
            </div>

            <!-- Mobile Location Selector Bar -->
            <div class="flex md:hidden items-center justify-between py-2 border-t border-slate-100 text-xs">
                <div class="flex items-center text-slate-700 cursor-pointer truncate" onclick="openLocationModal()">
                    <i class="fa-solid fa-location-dot text-fastOrange mr-1.5"></i>
                    <span class="text-slate-500 mr-1">Ke:</span>
                    <span id="mobile-selected-location" class="font-bold text-slate-900 truncate">Kampus UNSOED, PWT</span>
                    <i class="fa-solid fa-chevron-down ml-1 text-slate-400 text-[10px]"></i>
                </div>
                <div class="text-[11px] text-amber-700 font-bold bg-amber-100/80 px-2 py-0.5 rounded-full shrink-0">
                    ⚡ ~15-25 min
                </div>
            </div>
        </div>
    </header>

    <!-- Hero Banner & Search Section -->
    <section class="bg-gradient-to-br from-purwoDark via-slate-900 to-slate-800 text-white py-8 px-4 sm:px-6 lg:px-8 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10 speed-lines"></div>
        <div class="max-w-7xl mx-auto relative z-10">
            <div class="max-w-2xl">
                <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-md px-3 py-1 rounded-full text-xs font-medium text-amber-300 mb-3 border border-white/10">
                    <i class="fa-solid fa-fire text-fastYellow"></i> Khusus Wilayah Purwokerto & Sekitarnya
                </div>
                <h1 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
                    Lapar Melanda? <br class="hidden sm:inline"/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-fastYellow via-amber-400 to-fastOrange">
                        Makannn Faaasssttt Sampai Tempatmu!
                    </span>
                </h1>
                <p class="mt-2 text-slate-300 text-sm sm:text-base">
                    Nikmati Soto Sokaraja, Mendoan Kriuk UNSOED, hingga Ayam Raden Patah dengan garansi pengiriman super cepat.
                </p>

                <!-- Search Input Bar -->
                <div class="mt-6 flex flex-col sm:flex-row gap-2">
                    <div class="relative flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="text" id="search-input" onkeyup="handleSearch()" placeholder="Cari Mendoan, Soto Sokaraja, Ayam Geprek, Kopi..." 
                               class="w-full pl-11 pr-4 py-3 bg-white text-slate-900 rounded-xl sm:rounded-2xl shadow-lg focus:outline-none focus:ring-2 focus:ring-fastOrange font-medium text-sm">
                    </div>
                </div>
            </div>

            <!-- Promo Carousel / Banners -->
            <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
                <div onclick="applyVoucherDirect('PURWOKERTOFAST')" class="cursor-pointer bg-gradient-to-r from-fastOrange to-red-600 rounded-2xl p-4 text-white shadow-lg relative overflow-hidden group hover:scale-[1.02] transition">
                    <div class="relative z-10">
                        <span class="bg-black/30 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Promo Khusus</span>
                        <h3 class="font-extrabold text-lg mt-1">Gratis Ongkir UNSOED</h3>
                        <p class="text-xs text-orange-100">Gunakan kode: <span class="font-mono bg-white/20 px-1.5 py-0.5 rounded font-bold">PURWOKERTOFAST</span></p>
                    </div>
                    <i class="fa-solid fa-motorcycle absolute -right-2 -bottom-2 text-6xl text-white/10 group-hover:scale-110 transition"></i>
                </div>

                <div onclick="applyVoucherDirect('MENDOANFREE')" class="cursor-pointer bg-gradient-to-r from-amber-500 to-emerald-600 rounded-2xl p-4 text-white shadow-lg relative overflow-hidden group hover:scale-[1.02] transition">
                    <div class="relative z-10">
                        <span class="bg-black/30 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Diskon Mendoan</span>
                        <h3 class="font-extrabold text-lg mt-1">Potongan Rp 10.000</h3>
                        <p class="text-xs text-amber-100">Gunakan kode: <span class="font-mono bg-white/20 px-1.5 py-0.5 rounded font-bold">MENDOANFREE</span></p>
                    </div>
                    <i class="fa-solid fa-utensils absolute -right-2 -bottom-2 text-6xl text-white/10 group-hover:scale-110 transition"></i>
                </div>

                <div class="hidden md:block bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl p-4 text-white shadow-lg relative overflow-hidden">
                    <div class="relative z-10">
                        <span class="bg-black/30 text-white text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider">Jaminan Kilat</span>
                        <h3 class="font-extrabold text-lg mt-1">Nyampe &lt; 25 Menit</h3>
                        <p class="text-xs text-indigo-100">Driver area Purwokerto siap meluncur!</p>
                    </div>
                    <i class="fa-solid fa-bolt absolute -right-2 -bottom-2 text-6xl text-white/10"></i>
                </div>
            </div>
        </div>
    </section>

    <!-- Categories Scrollable Bar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <div class="flex items-center justify-between mb-3">
            <h2 class="text-lg font-black text-slate-900 tracking-tight">Kategori Makanan</h2>
            <button onclick="resetFilters()" class="text-xs font-bold text-fastOrange hover:underline">Lihat Semua</button>
        </div>

        <div id="category-container" class="flex gap-3 overflow-x-auto hide-scrollbar pb-2 pt-1">
            <!-- Categories will be rendered here dynamically -->
        </div>
    </section>

    <!-- Filter Quick Pills -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4">
        <div class="flex items-center gap-2 overflow-x-auto hide-scrollbar py-1">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-1">Filter:</span>
            
            <button onclick="toggleFilter('promo')" id="filter-promo" class="filter-pill bg-white border border-slate-200 text-slate-700 text-xs font-semibold px-3 py-1.5 rounded-full hover:border-fastOrange transition flex items-center gap-1.5 shrink-0">
                <i class="fa-solid fa-tags text-fastOrange"></i> Promo Super Fast
            </button>

            <button onclick="toggleFilter('rating')" id="filter-rating" class="filter-pill bg-white border border-slate-200 text-slate-700 text-xs font-semibold px-3 py-1.5 rounded-full hover:border-fastOrange transition flex items-center gap-1.5 shrink-0">
                <i class="fa-solid fa-star text-amber-400"></i> Rating 4.5+
            </button>

            <button onclick="toggleFilter('fast')" id="filter-fast" class="filter-pill bg-white border border-slate-200 text-slate-700 text-xs font-semibold px-3 py-1.5 rounded-full hover:border-fastOrange transition flex items-center gap-1.5 shrink-0">
                <i class="fa-solid fa-bolt text-fastYellow"></i> Under 20 Menit
            </button>

            <button onclick="toggleFilter('halal')" id="filter-halal" class="filter-pill bg-white border border-slate-200 text-slate-700 text-xs font-semibold px-3 py-1.5 rounded-full hover:border-fastOrange transition flex items-center gap-1.5 shrink-0">
                <i class="fa-solid fa-check-circle text-emerald-500"></i> Halal Verified
            </button>
        </div>
    </section>

    <!-- Restaurant Listings Section -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 id="section-title" class="text-xl font-extrabold text-slate-900">Restoran Terpopuler di Purwokerto</h2>
                <p id="section-subtitle" class="text-xs text-slate-500">Mulai dari kuliner lokal hingga resto favorit kampus</p>
            </div>
            <span id="restaurant-count" class="text-xs font-bold bg-slate-200 text-slate-700 px-2.5 py-1 rounded-full">0 Resto</span>
        </div>

        <!-- Grid Resto -->
        <div id="restaurant-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <!-- Restaurant Cards will be rendered dynamically -->
        </div>

        <!-- Empty State -->
        <div id="empty-state" class="hidden text-center py-12">
            <div class="w-20 h-20 bg-orange-100 text-fastOrange rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
                <i class="fa-solid fa-utensils"></i>
            </div>
            <h3 class="text-lg font-bold text-slate-800">Tidak ada restoran ditemukan</h3>
            <p class="text-slate-500 text-sm mt-1">Coba ubah kata kunci pencarian atau filter Anda.</p>
            <button onclick="resetFilters()" class="mt-4 bg-fastOrange text-white font-bold text-xs px-4 py-2 rounded-xl shadow">Reset Semua Filter</button>
        </div>
    </main>

    <!-- Restaurant Detail & Menu Modal -->
    <div id="resto-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-end sm:items-center justify-center hidden opacity-0 transition-opacity duration-200">
        <div class="bg-white w-full max-w-3xl max-h-[90vh] rounded-t-3xl sm:rounded-2xl overflow-hidden flex flex-col shadow-2xl transform transition-transform duration-300 translate-y-full sm:translate-y-0">
            
            <!-- Modal Header / Banner -->
            <div class="relative h-44 sm:h-52 bg-slate-800 shrink-0">
                <img id="modal-resto-img" src="" alt="" class="w-full h-full object-cover opacity-80">
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
                <button onclick="closeRestoModal()" class="absolute top-4 right-4 bg-black/50 text-white w-8 h-8 rounded-full flex items-center justify-center hover:bg-black/80 transition">
                    <i class="fa-solid fa-xmark"></i>
                </button>
                <div class="absolute bottom-4 left-4 right-4 text-white">
                    <span id="modal-resto-category" class="bg-fastOrange text-[10px] font-extrabold uppercase px-2 py-0.5 rounded text-white tracking-wider">Kategori</span>
                    <h2 id="modal-resto-name" class="text-xl sm:text-2xl font-black mt-1">Nama Resto</h2>
                    <div class="flex items-center text-xs text-slate-200 gap-3 mt-1">
                        <span><i class="fa-solid fa-star text-amber-400"></i> <span id="modal-resto-rating">4.8</span></span>
                        <span>•</span>
                        <span><i class="fa-solid fa-location-dot text-fastOrange"></i> <span id="modal-resto-distance">1.2 km</span></span>
                        <span>•</span>
                        <span><i class="fa-solid fa-clock text-amber-300"></i> <span id="modal-resto-time">15 min</span></span>
                    </div>
                </div>
            </div>

            <!-- Menu List -->
            <div class="p-4 sm:p-6 overflow-y-auto flex-1 space-y-4" id="modal-menu-container">
                <!-- Dynamic Menu Items -->
            </div>

            <!-- Footer Modal Cart Trigger -->
            <div class="p-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between shrink-0">
                <div>
                    <span class="text-xs text-slate-500">Item Terpilih</span>
                    <div class="font-extrabold text-slate-900 text-base" id="modal-cart-summary">0 Item | Rp 0</div>
                </div>
                <button onclick="closeRestoModal(); toggleCartDrawer();" class="bg-fastOrange hover:bg-orange-600 text-white px-5 py-2.5 rounded-xl font-bold text-sm shadow-md transition">
                    Lihat Keranjang <i class="fa-solid fa-arrow-right ml-1"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Customization Options Modal (For level pedas, extras) -->
    <div id="customize-modal" class="fixed inset-0 z-50 bg-black/70 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-md rounded-2xl overflow-hidden shadow-2xl p-5 space-y-4">
            <div class="flex justify-between items-start">
                <div>
                    <h3 id="cust-item-name" class="font-black text-slate-900 text-lg">Nama Menu</h3>
                    <p id="cust-item-price" class="text-fastOrange font-extrabold text-sm">Rp 0</p>
                </div>
                <button onclick="closeCustModal()" class="text-slate-400 hover:text-slate-600"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <!-- Level Pedas Option -->
            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-700 uppercase">Pilih Level Pedas:</label>
                <div class="grid grid-cols-3 gap-2" id="spicy-options">
                    <button type="button" onclick="selectSpicy(this, 'Tidak Pedas')" class="spicy-btn bg-slate-100 hover:bg-orange-50 border border-slate-200 rounded-xl p-2 text-xs font-bold text-slate-700">Tidak Pedas</button>
                    <button type="button" onclick="selectSpicy(this, 'Pedas Sedang')" class="spicy-btn active bg-orange-500 text-white border border-orange-500 rounded-xl p-2 text-xs font-bold">Sedang 🌶️</button>
                    <button type="button" onclick="selectSpicy(this, 'Pedas Gelora')" class="spicy-btn bg-slate-100 hover:bg-orange-50 border border-slate-200 rounded-xl p-2 text-xs font-bold text-slate-700">Extra Pedas 🌶️🌶️</button>
                </div>
            </div>

            <!-- Add-ons Option -->
            <div class="space-y-2">
                <label class="block text-xs font-bold text-slate-700 uppercase">Tambahan Ekstra:</label>
                <div class="space-y-1.5" id="extra-options">
                    <label class="flex items-center justify-between p-2 rounded-lg border border-slate-200 text-xs font-medium cursor-pointer hover:bg-slate-50">
                        <span><input type="checkbox" value="5000" data-name="Extra Mendoan (2pcs)" class="extra-cb text-fastOrange rounded mr-2"> Extra Mendoan (2pcs)</span>
                        <span class="font-bold text-slate-700">+Rp 5.000</span>
                    </label>
                    <label class="flex items-center justify-between p-2 rounded-lg border border-slate-200 text-xs font-medium cursor-pointer hover:bg-slate-50">
                        <span><input type="checkbox" value="3000" data-name="Sambal Kecap Extra" class="extra-cb text-fastOrange rounded mr-2"> Sambal Kecap Pedas</span>
                        <span class="font-bold text-slate-700">+Rp 3.000</span>
                    </label>
                    <label class="flex items-center justify-between p-2 rounded-lg border border-slate-200 text-xs font-medium cursor-pointer hover:bg-slate-50">
                        <span><input type="checkbox" value="4000" data-name="Es Teh Manis Purwokerto" class="extra-cb text-fastOrange rounded mr-2"> Es Teh Manis Jumbo</span>
                        <span class="font-bold text-slate-700">+Rp 4.000</span>
                    </label>
                </div>
            </div>

            <!-- Notes -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase mb-1">Catatan Khusus:</label>
                <input type="text" id="cust-notes" placeholder="cth: Sambal dipisah, minta goreng garing" class="w-full text-xs p-2.5 border border-slate-200 rounded-xl focus:ring-1 focus:ring-fastOrange outline-none">
            </div>

            <button onclick="confirmAddToCart()" class="w-full bg-gradient-to-r from-fastOrange to-red-600 text-white font-extrabold py-3 rounded-xl text-sm shadow-lg shadow-orange-500/30">
                Tambahkan ke Keranjang
            </button>
        </div>
    </div>

    <!-- Cart Drawer Slide-over -->
    <div id="cart-drawer" class="fixed inset-0 z-50 overflow-hidden hidden">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-xs transition-opacity" onclick="toggleCartDrawer()"></div>
        <div class="fixed inset-y-0 right-0 max-w-full flex pl-10">
            <div class="w-screen max-w-md bg-white shadow-2xl flex flex-col">
                
                <!-- Drawer Header -->
                <div class="p-4 bg-slate-900 text-white flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i class="fa-solid fa-basket-shopping text-fastYellow text-lg"></i>
                        <h2 class="font-extrabold text-base">Keranjang Pesanan</h2>
                    </div>
                    <button onclick="toggleCartDrawer()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
                </div>

                <!-- Delivery Address Detail -->
                <div class="p-3 bg-orange-50 border-b border-orange-100 text-xs flex items-center justify-between">
                    <div class="flex items-center gap-2 text-slate-700">
                        <i class="fa-solid fa-location-dot text-fastOrange"></i>
                        <span class="truncate max-w-[220px]" id="cart-delivery-address">Kampus UNSOED, Purwokerto Utara</span>
                    </div>
                    <button onclick="openLocationModal()" class="text-fastOrange font-bold hover:underline">Ubah</button>
                </div>

                <!-- Cart Items List -->
                <div id="cart-items-list" class="flex-1 overflow-y-auto p-4 space-y-3">
                    <!-- Items rendered here -->
                </div>

                <!-- Voucher & Payment Summary Area -->
                <div class="p-4 bg-slate-50 border-t border-slate-200 space-y-3">
                    
                    <!-- Voucher Input -->
                    <div class="flex gap-2">
                        <input type="text" id="voucher-code-input" placeholder="Kode Promo (PURWOKERTOFAST)" class="uppercase text-xs p-2 border border-slate-300 rounded-lg flex-1 outline-none font-mono">
                        <button onclick="applyVoucher()" class="bg-slate-800 text-white font-bold text-xs px-3 rounded-lg hover:bg-slate-700">Gunakan</button>
                    </div>
                    <div id="voucher-applied-tag" class="hidden text-[11px] font-bold text-emerald-600 bg-emerald-50 p-1.5 rounded border border-emerald-200 flex justify-between items-center">
                        <span><i class="fa-solid fa-ticket mr-1"></i> Promo Terpasang!</span>
                        <button onclick="removeVoucher()" class="text-red-500 font-bold">Hapus</button>
                    </div>

                    <!-- Payment Method Picker -->
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Metode Pembayaran:</label>
                        <select id="payment-method" class="w-full text-xs font-bold p-2 border border-slate-300 rounded-lg bg-white outline-none">
                            <option value="QRIS">QRIS / Instant All Payment</option>
                            <option value="GoPay">GoPay Purwokerto</option>
                            <option value="OVO">OVO</option>
                            <option value="DANA">DANA</option>
                            <option value="ShopeePay">ShopeePay</option>
                            <option value="COD">Cash on Delivery (COD)</option>
                        </select>
