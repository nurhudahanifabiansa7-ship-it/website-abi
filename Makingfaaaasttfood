                </button>
            `).join('');
        }

        function renderRestaurants() {
            const grid = document.getElementById('restaurant-grid');
            const emptyState = document.getElementById('empty-state');
            const searchKeyword = document.getElementById('search-input').value.toLowerCase();

            let filtered = restaurants.filter(r => {
                // Category filter
                if (activeCategory !== 'all' && r.category !== activeCategory) return false;

                // Search keyword
                if (searchKeyword && !r.name.toLowerCase().includes(searchKeyword) && !r.menu.some(m => m.name.toLowerCase().includes(searchKeyword))) {
                    return false;
                }

                // Quick Pills Filters
                if (activeFilters.promo && !r.isPromo) return false;
                if (activeFilters.rating && r.rating < 4.5) return false;
                if (activeFilters.fast && parseInt(r.time) > 20) return false;
                if (activeFilters.halal && !r.isHalal) return false;

                return true;
            });

            document.getElementById('restaurant-count').innerText = `${filtered.length} Resto`;

            if (filtered.length === 0) {
                grid.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            grid.innerHTML = filtered.map(resto => {
