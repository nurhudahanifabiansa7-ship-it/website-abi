        }

        function selectSpicy(btn, level) {
            document.querySelectorAll('.spicy-btn').forEach(b => {
                b.classList.remove('bg-orange-500', 'text-white', 'border-orange-500');
                b.classList.add('bg-slate-100', 'text-slate-700', 'border-slate-200');
            });
            btn.classList.remove('bg-slate-100', 'text-slate-700', 'border-slate-200');
            btn.classList.add('bg-orange-500', 'text-white', 'border-orange-500');
            btn.dataset.selectedLevel = level;
        }

        function confirmAddToCart() {
            if (!itemToCustomize || !activeRestoForModal) return;

            const spicyBtn = document.querySelector('.spicy-btn.bg-orange-500');
            const spicyLevel = spicyBtn ? (spicyBtn.dataset.selectedLevel || 'Pedas Sedang') : 'Pedas Sedang';

            let extraCost = 0;
            let extrasList = [];
            document.querySelectorAll('.extra-cb:checked').forEach(cb => {
                extraCost += parseInt(cb.value);
                extrasList.push(cb.dataset.name);
            });

            const notes = document.getElementById('cust-notes').value;

            const cartItem = {
                cartId: Date.now(),
                restoId: activeRestoForModal.id,
                restoName: activeRestoForModal.name,
                deliveryFee: activeRestoForModal.deliveryFee,
                itemId: itemToCustomize.id,
                name: itemToCustomize.name,
                basePrice: itemToCustomize.price,
                extraCost: extraCost,
                totalPrice: itemToCustomize.price + extraCost,
                spicyLevel: spicyLevel,
                extras: extrasList,
                notes: notes,
                qty: 1
            };

            cart.push(cartItem);
            closeCustModal();
            updateCartUI();
            updateModalSummary();
        }

        function updateCartUI() {
            const badge = document.getElementById('cart-badge');
            const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
            badge.innerText = totalQty;

            const cartList = document.getElementById('cart-items-list');
            if (cart.length === 0) {
                cartList.innerHTML = `
                    <div class="text-center py-12 text-slate-400">
                        <i class="fa-solid fa-basket-shopping text-4xl mb-2"></i>
                        <p class="text-xs font-bold">Keranjang Anda masih kosong</p>
                    </div>
                `;
            } else {
                cartList.innerHTML = cart.map(item => `
                    <div class="bg-slate-50 p-3 rounded-2xl border border-slate-200 space-y-2">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-extrabold text-slate-900 text-xs">${item.name}</h4>
                                <p class="text-[10px] text-slate-500">${item.restoName}</p>
                                <span class="text-[10px] bg-orange-100 text-orange-800 font-bold px-1.5 py-0.5 rounded">${item.spicyLevel}</span>
                                ${item.extras.length > 0 ? `<p class="text-[10px] text-slate-500 mt-1">+ ${item.extras.join(', ')}</p>` : ''}
                            </div>
                            <span class="font-black text-xs text-fastOrange">Rp ${(item.totalPrice * item.qty).toLocaleString('id-ID')}</span>
                        </div>
                        <div class="flex items-center justify-between pt-2 border-t border-slate-200/60">
                            <span class="text-[10px] text-slate-400 italic">${item.notes ? `"${item.notes}"` : 'Tanpa catatan'}</span>
                            <div class="flex items-center gap-2">
                                <button onclick="changeQty(${item.cartId}, -1)" class="w-6 h-6 rounded-lg bg-white border border-slate-300 text-xs font-bold hover:bg-slate-100">-</button>
                                <span class="text-xs font-black">${item.qty}</span>
                                <button onclick="changeQty(${item.cartId}, 1)" class="w-6 h-6 rounded-lg bg-fastOrange text-white text-xs font-bold hover:bg-orange-600">+</button>
                            </div>
                        </div>
                    </div>
                `).join('');
            }

            calculateTotals();
        }

        function updateModalSummary() {
            const summary = document.getElementById('modal-cart-summary');
            if (!activeRestoForModal) return;
            const restoItems = cart.filter(i => i.restoId === activeRestoForModal.id);
            const qty = restoItems.reduce((s, i) => s + i.qty, 0);
            const total = restoItems.reduce((s, i) => s + (i.totalPrice * i.qty), 0);
            summary.innerText = `${qty} Item | Rp ${total.toLocaleString('id-ID')}`;
        }

        function changeQty(cartId, delta) {
            const index = cart.findIndex(i => i.cartId === cartId);
            if (index > -1) {
                cart[index].qty += delta;
                if (cart[index].qty <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
            updateModalSummary();
        }

        function toggleCartDrawer() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('hidden');
        }

        function applyVoucherDirect(code) {
            document.getElementById('voucher-code-input').value = code;
            toggleCartDrawer();
            applyVoucher();
        }

        function applyVoucher() {
            const code = document.getElementById('voucher-code-input').value.trim().toUpperCase();
            if (code === 'PURWOKERTOFAST') {
                appliedVoucher = { code: 'PURWOKERTOFAST', discountShipping: true, discountAmount: 5000 };
            } else if (code === 'MENDOANFREE') {
                appliedVoucher = { code: 'MENDOANFREE', discountShipping: false, discountAmount: 10000 };
            } else {
                alert('Kode voucher tidak valid!');
                return;
            }

            document.getElementById('voucher-applied-tag').classList.remove('hidden');
            calculateTotals();
        }

        function removeVoucher() {
            appliedVoucher = null;
            document.getElementById('voucher-applied-tag').classList.add('hidden');
            calculateTotals();
        }

        function calculateTotals() {
            const subtotal = cart.reduce((sum, item) => sum + (item.totalPrice * item.qty), 0);
            
            // Shipping calculation: highest resto shipping fee or flat default
            let shipping = cart.length > 0 ? Math.max(...cart.map(i => i.deliveryFee)) : 5000;
            let platformFee = cart.length > 0 ? 2000 : 0;
            let discount = 0;

            if (appliedVoucher) {
                if (appliedVoucher.discountShipping) {
                    discount += shipping;
                } else {
                    discount += appliedVoucher.discountAmount;
                }
            }

            const total = Math.max(0, subtotal + shipping + platformFee - discount);

            document.getElementById('summary-subtotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('summary-shipping').innerText = `Rp ${shipping.toLocaleString('id-ID')}`;
            document.getElementById('summary-platform').innerText = `Rp ${platformFee.toLocaleString('id-ID')}`;
            document.getElementById('summary-total').innerText = `Rp ${total.toLocaleString('id-ID')}`;

            const discountRow = document.getElementById('discount-row');
            if (discount > 0) {
                discountRow.classList.remove('hidden');
                discountRow.classList.add('flex');
                document.getElementById('summary-discount').innerText = `-Rp ${discount.toLocaleString('id-ID')}`;
            } else {
                discountRow.classList.add('hidden');
                discountRow.classList.remove('flex');
            }
        }

        function processCheckout() {
            if (cart.length === 0) {
                alert('Keranjang Anda masih kosong. Silahkan pilih makanan terlebih dahulu!');
                return;
            }

            toggleCartDrawer();
            openTrackerModal();
        }

        function openTrackerModal() {
            const modal = document.getElementById('tracker-modal');
            modal.classList.remove('hidden');

            // Trigger Confetti
            confetti({
                particleCount: 80,
                spread: 60,
                origin: { y: 0.6 }
            });

            startOrderSimulation();
        }

        function closeTrackerModal() {
            document.getElementById('tracker-modal').classList.add('hidden');
            cart = [];
            appliedVoucher = null;
            updateCartUI();
        }

        function startOrderSimulation() {
            const icon = document.getElementById('tracker-animation-icon');
            const title = document.getElementById('tracker-status-title');
            const desc = document.getElementById('tracker-status-desc');

            const step1 = document.getElementById('step-1');
            const step2 = document.getElementById('step-2');
            const step3 = document.getElementById('step-3');
            const step4 = document.getElementById('step-4');

            // Reset steps
            [step2, step3, step4].forEach(s => s.className = 'h-2 rounded-full bg-slate-200');

            // Stage 1: Store Confirmation
            icon.innerHTML = '<i class="fa-solid fa-store animate-bounce"></i>';
            title.innerText = 'Pesanan Diterima Restoran Purwokerto';
            desc.innerText = 'Dapur sedang mempersiapkan hidangan hangat Anda.';

            setTimeout(() => {
                // Stage 2: Cooking
                step2.className = 'h-2 rounded-full bg-fastOrange';
                icon.innerHTML = '<i class="fa-solid fa-fire-burner animate-spin text-amber-500"></i>';
                title.innerText = 'Makanan Sedang Dimasak...';
                desc.innerText = 'Bumbu rempah racikan khas sedang disiapkan.';
            }, 3000);

            setTimeout(() => {
                // Stage 3: Driver On The Way
                step3.className = 'h-2 rounded-full bg-fastOrange';
                icon.innerHTML = '<i class="fa-solid fa-motorcycle animate-pulse text-fastOrange text-7xl"></i>';
                title.innerText = 'Driver Kilat Meluncur!';
                desc.innerText = `Mas Slamet menuju ke ${currentLocation}.`;
            }, 6000);

            setTimeout(() => {
                // Stage 4: Delivered
                step4.className = 'h-2 rounded-full bg-emerald-500';
                icon.innerHTML = '<i class="fa-solid fa-circle-check text-emerald-500 text-7xl"></i>';
                title.innerText = 'Makanan Sampai di Tempat!';
                desc.innerText = 'Selamat menikmati santapan lezat Making Faaasssttt Food!';

                confetti({
                    particleCount: 120,
                    spread: 80,
                    origin: { y: 0.5 }
                });
            }, 9500);
        }

        function openLocationModal() {
            document.getElementById('location-modal').classList.remove('hidden');
        }

        function closeLocationModal() {
            document.getElementById('location-modal').classList.add('hidden');
        }

        function selectLocationOption(loc) {
            currentLocation = loc;
            renderLocations();
        }

        function saveLocation() {
            const detail = document.getElementById('street-detail-input').value;
            const fullLoc = detail ? `${currentLocation} (${detail})` : currentLocation;

            document.getElementById('selected-location-text').innerText = fullLoc;
            document.getElementById('mobile-selected-location').innerText = fullLoc;
            document.getElementById('cart-delivery-address').innerText = fullLoc;

            closeLocationModal();
        }
    </script>
</body>
</html>
